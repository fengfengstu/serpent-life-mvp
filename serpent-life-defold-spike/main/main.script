local W = 390
local H = 844
local TWO_PI = math.pi * 2

local function clamp(v, lo, hi)
	return math.max(lo, math.min(hi, v))
end

local function dist(a, b)
	local dx = a.x - b.x
	local dy = a.y - b.y
	return math.sqrt(dx * dx + dy * dy)
end

local function angle_to(a, b)
	return math.atan2(b.y - a.y, b.x - a.x)
end

local function lerp_angle(a, b, t)
	local d = (b - a + math.pi) % TWO_PI - math.pi
	return a + d * t
end

local function id_url(id)
	return "/" .. id
end

local function place(id, x, y, scale, angle)
	go.set_position(vmath.vector3(x, y, 0), id_url(id))
	go.set_scale(vmath.vector3(scale, scale, 1), id_url(id))
	if angle then
		go.set_rotation(vmath.quat_rotation_z(angle), id_url(id))
	end
end

local function hide(id)
	go.set_position(vmath.vector3(-500, -500, 0), id_url(id))
	go.set_scale(vmath.vector3(0.001, 0.001, 1), id_url(id))
end

local function edge_spawn()
	local side = math.random(1, 4)
	if side == 1 then return { x = -42, y = math.random(80, H - 80) } end
	if side == 2 then return { x = W + 42, y = math.random(80, H - 80) } end
	if side == 3 then return { x = math.random(40, W - 40), y = -42 } end
	return { x = math.random(40, W - 40), y = H + 42 }
end

local function reset_pickup(self, p)
	p.x = math.random(52, W - 52)
	p.y = math.random(130, H - 78)
	p.on = true
end

local function reset_enemy(self, e)
	local p = edge_spawn()
	e.x = p.x
	e.y = p.y
	e.hp = e.kind == 3 and 7 or e.kind == 2 and 4 or 2
	e.speed = e.kind == 3 and 44 or e.kind == 2 and 78 or 58
	e.on = true
	e.slow = 0
end

local function restart(self)
	self.mode = "playing"
	self.time = 0
	self.hp = 3
	self.length = 5
	self.score = 0
	self.fire_level = 1
	self.frost_level = 1
	self.fire_cd = 0.6
	self.frost_cd = 0.2
	self.player = { x = W * 0.5, y = H * 0.5, angle = 0, target = 0 }
	self.trail = {}
	self.drag = nil
	for i = 1, 260 do
		self.trail[i] = { x = self.player.x - i * 2, y = self.player.y, angle = 0 }
	end
	self.enemies = {}
	for i = 1, 10 do
		self.enemies[i] = { id = "enemy_" .. i, kind = (i % 3) + 1, on = true }
		reset_enemy(self, self.enemies[i])
	end
	self.pickups = {}
	for i = 1, 5 do
		self.pickups[i] = { id = "pickup_" .. i, on = true }
		reset_pickup(self, self.pickups[i])
	end
	self.fire = {}
	for i = 1, 4 do self.fire[i] = { id = "fire_" .. i, life = 0 } end
	self.frost = {}
	for i = 1, 6 do self.frost[i] = { id = "frost_" .. i, life = 0 } end
end

local function trigger_fire(self)
	local count = math.min(4, 1 + math.floor(self.length / 4))
	for i = 1, count do
		local fx = self.fire[i]
		local idx = 1 + (i - 1) * 18
		local p = self.trail[idx] or self.player
		fx.x = p.x
		fx.y = p.y
		fx.life = 0.42
		fx.radius = 64 + self.fire_level * 8
		for _, e in ipairs(self.enemies) do
			if e.on and dist(fx, e) < fx.radius then
				e.hp = e.hp - (1.8 + self.fire_level * 0.5)
				if e.hp <= 0 then
					self.score = self.score + 1
					reset_enemy(self, e)
				end
			end
		end
	end
end

local function trigger_frost(self)
	local slot = 1
	local min_life = 999
	for i, f in ipairs(self.frost) do
		if f.life < min_life then
			min_life = f.life
			slot = i
		end
	end
	local f = self.frost[slot]
	f.x = self.player.x
	f.y = self.player.y
	f.angle = self.player.angle
	f.life = 1.4
	f.radius = 48
end

function init(self)
	math.randomseed(os.time())
	msg.post(".", "acquire_input_focus")
	place("bg", W * 0.5, H * 0.5, 0.43, 0)
	place("boss", W * 0.5, H * 0.92, 0.001, 0)
	place("shield", -500, -500, 0.001, 0)
	place("lightning", -500, -500, 0.001, 0)
	restart(self)
end

function update(self, dt)
	if self.mode ~= "playing" then
		self.time = self.time + dt
		place("boss", W * 0.5, H * 0.52, 0.36 + math.sin(self.time * 6) * 0.02, 0)
		return
	end

	self.time = self.time + dt
	if self.player.x > W - 58 then self.player.target = math.pi end
	if self.player.x < 58 then self.player.target = 0 end
	if self.player.y > H - 72 then self.player.target = -math.pi * 0.5 end
	if self.player.y < 112 then self.player.target = math.pi * 0.5 end
	local turn = 8.0
	self.player.angle = lerp_angle(self.player.angle, self.player.target, clamp(turn * dt, 0, 1))
	local speed = 124 + math.min(26, self.score * 0.6)
	self.player.x = clamp(self.player.x + math.cos(self.player.angle) * speed * dt, 32, W - 32)
	self.player.y = clamp(self.player.y + math.sin(self.player.angle) * speed * dt, 84, H - 36)

	table.insert(self.trail, 1, { x = self.player.x, y = self.player.y, angle = self.player.angle })
	while #self.trail > 260 do table.remove(self.trail) end

	place("snake_head", self.player.x, self.player.y, 0.15, self.player.angle)
	for i = 1, 12 do
		if i <= self.length then
			local p = self.trail[1 + i * 11] or self.player
			local taper = 1 - i / 15
			place("segment_" .. i, p.x, p.y, 0.07 + taper * 0.018, p.angle + math.pi * 0.5)
		else
			hide("segment_" .. i)
		end
	end

	for _, p in ipairs(self.pickups) do
		if p.on then
			place(p.id, p.x, p.y, 0.075 + math.sin(self.time * 6) * 0.006, self.time)
			if dist(self.player, p) < 34 then
				self.length = math.min(12, self.length + 1)
				self.score = self.score + 1
				if self.score % 3 == 0 then self.fire_level = self.fire_level + 1 end
				if self.score % 4 == 0 then self.frost_level = self.frost_level + 1 end
				reset_pickup(self, p)
			end
		else
			hide(p.id)
		end
	end

	for _, e in ipairs(self.enemies) do
		local a = angle_to(e, self.player)
		local slow = e.slow > 0 and 0.46 or 1
		e.slow = math.max(0, e.slow - dt)
		e.x = e.x + math.cos(a) * e.speed * slow * dt
		e.y = e.y + math.sin(a) * e.speed * slow * dt
		local scale = e.kind == 3 and 0.15 or e.kind == 2 and 0.13 or 0.105
		place(e.id, e.x, e.y, scale, a)
		if dist(self.player, e) < 30 then
			self.hp = self.hp - 1
			reset_enemy(self, e)
			if self.hp <= 0 then
				self.mode = "dead"
				for _, enemy in ipairs(self.enemies) do hide(enemy.id) end
				for _, p in ipairs(self.pickups) do hide(p.id) end
				return
			end
		end
	end

	self.fire_cd = self.fire_cd - dt
	if self.fire_cd <= 0 then
		self.fire_cd = math.max(0.34, 0.88 - self.fire_level * 0.06)
		trigger_fire(self)
	end

	self.frost_cd = self.frost_cd - dt
	if self.frost_cd <= 0 then
		self.frost_cd = 0.42
		trigger_frost(self)
	end

	for _, f in ipairs(self.frost) do
		if f.life > 0 then
			f.life = f.life - dt
			place(f.id, f.x, f.y, 0.18 * clamp(f.life, 0, 1), f.angle + self.time * 0.5)
			for _, e in ipairs(self.enemies) do
				if dist(f, e) < f.radius then e.slow = 0.5 end
			end
		else
			hide(f.id)
		end
	end

	for _, f in ipairs(self.fire) do
		if f.life > 0 then
			f.life = f.life - dt
			place(f.id, f.x, f.y, 0.22 * clamp(f.life * 2.2, 0, 1), self.time * 4)
		else
			hide(f.id)
		end
	end

	place("shield", self.player.x + math.cos(self.time * 5) * 44, self.player.y + math.sin(self.time * 5) * 44, 0.08, -self.time * 5)
	local lp = self.trail[44] or self.player
	place("lightning", lp.x, lp.y, 0.09 + math.sin(self.time * 12) * 0.012, -self.time * 4)
	hide("boss")
end

function on_input(self, action_id, action)
	if action_id == hash("restart") and action.pressed then
		restart(self)
		return
	end

	if action_id == hash("touch") then
		if action.pressed then
			if self.mode == "dead" then restart(self) return end
			self.drag = { x = action.x, y = action.y }
		elseif action.released then
			self.drag = nil
		elseif self.drag then
			local dx = action.x - self.drag.x
			local dy = action.y - self.drag.y
			if math.sqrt(dx * dx + dy * dy) > 5 then
				self.player.target = math.atan2(dy, dx)
			end
		end
	elseif action_id == hash("multitouch") and action.touch and #action.touch > 0 then
		local t = action.touch[1]
		if t.pressed then
			if self.mode == "dead" then restart(self) return end
			self.drag = { x = t.x, y = t.y }
		elseif t.released then
			self.drag = nil
		elseif self.drag then
			local dx = t.x - self.drag.x
			local dy = t.y - self.drag.y
			if math.sqrt(dx * dx + dy * dy) > 5 then
				self.player.target = math.atan2(dy, dx)
			end
		end
	elseif action.pressed or action.repeated then
		if action_id == hash("up") then self.player.target = math.pi * 0.5 end
		if action_id == hash("down") then self.player.target = -math.pi * 0.5 end
		if action_id == hash("left") then self.player.target = math.pi end
		if action_id == hash("right") then self.player.target = 0 end
	end
end
